<h1>予約確認</h1>

<p>施設名：<%= @room.name %></p>
<p>チェックイン日：<%= @reservation.check_in.strftime("%Y/%m/%d") %></p>
<p>チェックアウト日：<%= @reservation.check_out.strftime("%Y/%m/%d") %></p>
<% nights = (@reservation.check_out - @reservation.check_in).to_i %>
<p>宿泊日数：<%= nights %>泊</p>
<p>人数：<%= @reservation.guests %>人</p>
<p>支払い金額：<%= @room.price * nights * @reservation.guests %>円</p>

<%= form_with model: [@room, @reservation], url: room_reservations_path(@room) do |f| %>
  <%= f.hidden_field :check_in %>
  <%= f.hidden_field :check_out %>
  <%= f.hidden_field :guests %>
  <%= f.submit "予約を確定する" %>
<% end %>

<%= link_to "戻る", :back %>