<h1>予約一覧</h1>

<% @reservations.each do |reservation| %>
  <div>
    <% if reservation.room.image.attached? %>
      <%= image_tag reservation.room.image %>
    <% else %>
      <%= image_tag "default_room.png" %>
    <% end %>
    <p>施設名：<%= reservation.room.name %></p>
    <p>紹介文：<%= reservation.room.description %></p>
    <p>チェックイン日：<%= reservation.check_in.strftime("%Y/%m/%d") %></p>
    <p>チェックアウト日：<%= reservation.check_out.strftime("%Y/%m/%d") %></p>
    <% nights = (reservation.check_out - reservation.check_in).to_i %>
    <p>合計料金：<%= reservation.room.price * nights * reservation.guests %>円</p>
    <p>予約確定日時：<%= reservation.created_at.strftime("%Y/%m/%d %H:%M") %></p>
  </div>
<% end %>